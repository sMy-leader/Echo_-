# ============================================================
# Unity 项目 .gitignore
# 原则：只忽略"可重新生成"和"本机专属"的文件；
#       Assets/ 下的所有 .meta 必须提交，否则引用会丢失。
# ============================================================

# ---------- Unity 自动生成 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---------- 构建 / 打包产物 ----------
*.apk
*.aab
*.app
*.unitypackage
*.exe
*.pdb
*.mdb

# YooAsset / 热更构建输出（按实际输出目录调整）
/[Bb]undles/
/[Ss]erverData/
/[Bb]uildOutput/

# ---------- IDE ----------
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.VC.VC.opendb

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时 / 备份 ----------
*.tmp
*.bak
*.orig
*.rej
~*

# ---------- Asset Store 工具 ----------
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------- 崩溃 / 分析 ----------
crashlytics-build.properties
sysinfo.txt
